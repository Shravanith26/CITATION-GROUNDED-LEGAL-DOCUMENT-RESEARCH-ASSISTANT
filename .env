# ==============================================================================
# Citation-Grounded Legal Document Research Assistant - Environment Config
# ==============================================================================

# Application Settings
APP_NAME="Citation-Grounded Legal Document Research Assistant"
APP_ENV=development
DEBUG=True
API_HOST=127.0.0.1
API_PORT=8000

# Storage & Database Paths
DATABASE_URL="sqlite:///./data/metadata/documents.db"
VECTOR_DB_DIR="./data/vector_db/chroma"
RAW_DOCUMENTS_DIR="./data/documents/raw"
PROCESSED_DOCUMENTS_DIR="./data/documents/processed"
LOGS_DIR="./logs"

# AI / ML Models
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
SPACY_MODEL="en_core_web_sm"

# LLM Configuration (Ollama local inference with graceful offline fallback)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="phi4-mini"
OLLAMA_FALLBACK_MODEL="llama3.2:3b"
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=30

# RAG & Retrieval Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.30
ENABLE_RERANKING=True
